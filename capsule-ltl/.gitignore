# ── Lean / Lake ──────────────────────────────────────────────────────────────
lean/.lake/
lean/.lake-cache/
lean/lake-manifest.json      # auto-updated by lake; pin via lean-toolchain instead

# ── TLA+ / TLAPS ─────────────────────────────────────────────────────────────
tla+/*.tlaps/                 # TLAPS proof-obligation cache directories
tla+/states/                  # TLC counterexample state dumps

# ── Rust / Cargo ─────────────────────────────────────────────────────────────
rust/aeneas/target/
rust/aeneas/Cargo.toml        # throwaway crate created by extract.sh
rust/aeneas/Cargo.lock
rust/aeneas/*.rlib            # compiled Rust libraries
rust/verus/target/

# ── Aeneas-pipeline generated Lean output ────────────────────────────────────
# lean/Capsule.lean et al. under rust/aeneas/lean/ are regenerated by extract.sh.
# They are tracked as a convenience snapshot so REPRODUCE.md step 1 works
# without Charon/Aeneas installed.  Uncomment the line below to stop tracking:
# rust/aeneas/lean/*.lean

# ── LaTeX build artefacts (if paper source is ever added here) ────────────────
*.aux
*.bbl
*.blg
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdf

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*~
*.swp
*.swo
